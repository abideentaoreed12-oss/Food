# ==============================================================================
# Veyrang Official Canonical Environment Configuration Contract (.env.example)
# Framework: Next.js 15+ (App Router) | Platform: Vercel / Node.js
# Security Principle: Fail closed. Never use mock data or insecure fallbacks.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME & SECURITY
# ------------------------------------------------------------------------------
# Deployment environment: 'development', 'test', or 'production'
NODE_ENV=production

# Application base URL (e.g. https://www.veyrang.com)
APP_URL=https://www.veyrang.com

# Client-side exposed application base URL
NEXT_PUBLIC_APP_URL=https://www.veyrang.com

# Mandatory cryptographically random JWT signing secret (min 32 bytes)
JWT_SECRET=

# Initial Bootstrap Administrator Credentials (used when initializing live system)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allowed origins for CORS (comma-separated, optional)
ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE SERVICES (D1 SQLite & R2 Object Storage)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (32 hex characters)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare D1 Database ID (UUID)
CLOUDFLARE_DATABASE_ID=

# Primary Cloudflare API Token (fallback for D1 and R2 operations)
CLOUDFLARE_API_TOKEN=

# Dedicated Scoped API Tokens (Optional, recommended for least-privilege)
CLOUDFLARE_D1_API_TOKEN=
CLOUDFLARE_R2_API_TOKEN=

# Cloudflare Account Auth Email (Required only when using legacy Global API Keys)
CLOUDFLARE_AUTH_EMAIL=

# Cloudflare R2 Bucket Name
CLOUDFLARE_R2_BUCKET=

# Public CDN URL for R2 Bucket assets (e.g. https://assets.veyrang.com)
CLOUDFLARE_R2_PUBLIC_URL=

# Optional Cloudflare Worker Proxy Endpoint
CLOUDFLARE_WORKER_URL=

# Optional Cloudflare DNS Zone ID
CLOUDFLARE_ZONE_ID=

# ------------------------------------------------------------------------------
# 3. PAYSTACK OFFICIAL PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Official Server-side Paystack Secret Key (sk_live_... or sk_test_...)
PAYSTACK_SECRET_KEY=

# Official Client-side Paystack Public Key (pk_live_... or pk_test_...)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Official Paystack Callback & Webhook URLs
PAYSTACK_CALLBACK_URL=https://www.veyrang.com/payment/callback
PAYSTACK_WEBHOOK_URL=https://www.veyrang.com/api/webhooks/paystack

# Optional Dedicated Virtual Account Bank Code (e.g. wema-bank)
PAYSTACK_DVA_BANK=wema-bank

# ------------------------------------------------------------------------------
# 4. EMAIL DISPATCH & NOTIFICATIONS (Resend API or SMTP / Gmail)
# ------------------------------------------------------------------------------
# Email Sender Display Name
EMAIL_SENDER_NAME=Veyrang Food Express

# Resend Primary Service (API Key & Webhook Secret)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Standard SMTP / Gmail App Password Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Legacy SMTP Aliases (Backward-compatible with Gmail configuration)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 5. SCHEDULED JOBS & VERCEL CRON SECURITY
# ------------------------------------------------------------------------------
# Shared secret for authenticating scheduled cron calls (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# ------------------------------------------------------------------------------
# 6. MAPPING, ROUTING & GEOCODING SERVICES
# ------------------------------------------------------------------------------
# Optional Google Maps API Key for client geocoding & map renders
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OpenStreetMap / Photon / OSRM / Valhalla High-Performance Routing Endpoints
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla.openstreetmap.de