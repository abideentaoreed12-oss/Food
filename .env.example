# -----------------------------------------------------------------------------
# Veyrang Environment Configuration Template (.env.example)
# -----------------------------------------------------------------------------

# Application & Server Setup
NODE_ENV="production"
PORT="3000"
APP_URL="https://veyrang.com"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
JWT_SECRET="your-32-character-secret-key-for-jwt"

# Cloudflare D1 SQL Database & Edge Workers
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_DATABASE_ID="your-cloudflare-database-id"
CLOUDFLARE_DATABASE_NAME="veyrang_production"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_WORKER_URL="https://your-worker-subdomain.workers.dev"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_BUCKET="your-bucket-name"
CLOUDFLARE_R2_PUBLIC_URL="https://cdn.yourdomain.com"

# External Payment Gateway Webhook & Keys
PAYMENT_WEBHOOK_SECRET="whsec_your_gateway_webhook_signing_secret"
PAYMENT_SECRET_KEY="sk_live_your_payment_secret_key"
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY="pk_live_your_payment_public_key"

# Google Maps Platform Key
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# Production Admin Seed Credentials
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="set-a-strong-password"

# Resend Email Delivery API Key
RESEND_API_KEY="re_your_resend_api_key"

# Gemini AI (Server-Side Secret)
GEMINI_API_KEY="your-gemini-api-key"
