# -----------------------------------------------------------------------------
# Veyrang Production Environment Configuration Template
# All secret credentials MUST remain strictly server-side.
# Do NOT prefix private database tokens, payment secrets, or passwords with NEXT_PUBLIC_.
# -----------------------------------------------------------------------------

# Primary Application URL
NEXT_PUBLIC_APP_URL=https://www.veyrang.com
APP_URL=https://www.veyrang.com

# Core Security & Admin Authentication
ADMIN_EMAIL=admin@veyrang.com
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=your_jwt_secret_minimum_32_characters

# Cloudflare D1 (Authoritative Production SQL Database)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_DATABASE_ID=your_cloudflare_d1_database_uuid
CLOUDFLARE_DATABASE_NAME=veyrang_production
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_AUTH_EMAIL=admin@veyrang.com
CLOUDFLARE_WORKER_URL=https://veyrang-api.your_subdomain.workers.dev

# Cloudflare R2 (Durable Object & Snapshot Storage)
CLOUDFLARE_R2_BUCKET=veyrang-production-storage
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.veyrang.com

# Paystack Payment Gateway Integration
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_CALLBACK_URL=https://www.veyrang.com/payment/callback
PAYSTACK_WEBHOOK_URL=https://www.veyrang.com/api/webhooks/paystack

# Google Maps Platform (Frontend & Distance Calculation)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_your_public_google_maps_browser_key
GOOGLE_MAPS_API_KEY=AIzaSy_your_google_maps_api_key

# Email Dispatch Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
GMAIL_USER=support@veyrang.com
GMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_SENDER_NAME="Veyrang Support"
RESEND_API_KEY=

# Geocoding & Routing Services (OpenStreetMap / Valhalla / OSRM)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla.openstreetmap.de