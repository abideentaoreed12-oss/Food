# ==============================================================================
# VEYRANG PRODUCTION SECRETS
# Only sensitive credentials belong here.
# All public URLs, Paystack public key, callback/webhook URLs, and Gmail SMTP
# defaults (smtp.gmail.com:465) are permanently configured in .env and runtime code.
# ==============================================================================

# Authentication & Admin
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare D1 & Storage Secrets
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_R2_BUCKET=

# Paystack Official Live Secret Key (Used for server REST API & webhook HMAC verification)
PAYSTACK_SECRET_KEY=

# Gmail SMTP Credentials (Only your email and Google App Password are required)
GMAIL_USER=
GMAIL_APP_PASSWORD=
