# -----------------------------------------------------------------------------
# VeyraNG Production Environment Configuration (.env.example)
# -----------------------------------------------------------------------------

# Application & Server Setup
NODE_ENV="production"
PORT="3000"
APP_URL="https://veyrang.com"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
JWT_SECRET="generate-a-strong-32-character-secret-key-for-jwt"

# External Payment Gateway Webhook Secret
PAYMENT_WEBHOOK_SECRET="whsec_your_gateway_webhook_signing_secret"
STRIPE_SECRET_KEY="sk_live_your_production_stripe_secret_key"
STRIPE_PUBLIC_KEY="pk_live_your_production_stripe_publishable_key"

# Cloudflare D1 SQL Database (Add to Vercel Environment Variables)
CLOUDFLARE_ACCOUNT_ID="661a09bca00f369ea7301c3b6c9e6b6b"
CLOUDFLARE_DATABASE_ID="bfaade8e-23b9-4678-a8b3-c4bd87d510ea"
CLOUDFLARE_DATABASE_NAME="veyrang_production"
CLOUDFLARE_API_TOKEN="cfut_your_cloudflare_api_token_with_d1_and_r2_permissions"
CLOUDFLARE_WORKER_URL="https://veyrang-api.abideentaoreed12.workers.dev"

# Cloudflare R2 Object Storage (Add to Vercel Environment Variables)
CLOUDFLARE_R2_BUCKET="veyrang-production-storage"
CLOUDFLARE_R2_PUBLIC_URL="https://cdn.veyrang.com"

# Optional S3 Compatibility for R2 (if using AWS S3 SDK or presigned URLs)
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_ENDPOINT="https://661a09bca00f369ea7301c3b6c9e6b6b.r2.cloudflarestorage.com"

# Production Monitoring & Analytics
SENTRY_DSN=""
VERCEL_ANALYTICS_ID=""

# Google Maps Platform Key (Used for doorstep GPS tracking and address maps)
GOOGLE_MAPS_API_KEY="AIzaSyAmbptl02WYRIvSdBljM2NahJAjnf-OfUw"

# Gemini AI (Optional Grounding / AI Features)
GEMINI_API_KEY=""

# Production Admin Seed Credentials (Overriding hardcoded seed fallbacks)
ADMIN_EMAIL="abideentaoreed12@gmail.com"
