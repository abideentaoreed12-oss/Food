# -----------------------------------------------------------------------------
# Veyrang Environment Configuration Template (.env.example)
# Copy to .env / Vercel Project Settings. Never commit real secrets.
# -----------------------------------------------------------------------------

# Application
NODE_ENV=production
PORT=3000
APP_URL=https://veyrang.com
ALLOWED_ORIGINS=https://veyrang.com,https://www.veyrang.com

# Auth (openssl rand -base64 48)
JWT_SECRET=

# Cloudflare D1
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_DATABASE_NAME=veyrang_production
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_URL=
CLOUDFLARE_ZONE_ID=

# Cloudflare R2
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Paystack (server secrets — never NEXT_PUBLIC for secret)
PAYSTACK_SECRET_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_PAYMENT_PUBLIC_KEY=
PAYSTACK_DVA_BANK=wema-bank

# Google Maps
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Admin seed (email/password only — wallets start at 0)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: seed sample restaurants from mockData (default off)
SEED_DEMO_RESTAURANTS=false

# Email / AI (optional)
RESEND_API_KEY=
GEMINI_API_KEY=


# Location/geocoding and live road-routing providers.
# Public community endpoints have fair-use/rate limits; use managed or self-hosted
# endpoints for production traffic and follow each provider's attribution policy.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io
PELIAS_BASE_URL=
PELIAS_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=
VALHALLA_API_KEY=
GRAPHHOPPER_API_KEY=
OPENROUTESERVICE_API_KEY=
